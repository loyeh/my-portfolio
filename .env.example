# Optional. Raises the GitHub API rate limit from 60/hr (unauthenticated) to
# 5,000/hr. A fine-grained personal access token with no special scopes is
# enough — it's only used to read public repo data.
GITHUB_TOKEN=

# Used for sitemap.xml, robots.txt, and Open Graph metadata. Set this to your
# deployed domain once you have one.
NEXT_PUBLIC_SITE_URL=https://example.com

# Required for the /contact form to send email (src/app/api/contact/route.ts).
# Get an API key at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional. Until you verify a sending domain at resend.com/domains, mail is
# sent from onboarding@resend.dev, which Resend's sandbox mode will only
# deliver to the email address registered on your Resend account. Set this to
# that address to unblock local testing; otherwise the form falls back to
# siteConfig.contactEmail. Remove this once a domain is verified.
CONTACT_TO_EMAIL=
