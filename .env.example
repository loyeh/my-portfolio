# Optional. Raises the GitHub API rate limit from 60/hr (unauthenticated) to
# 5,000/hr. A fine-grained personal access token with no special scopes is
# enough — it's only used to read public repo data.
GITHUB_TOKEN=

# Used for sitemap.xml, robots.txt, and Open Graph metadata. Set this to your
# deployed domain once you have one.
NEXT_PUBLIC_SITE_URL=https://example.com
